@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["ShowHero"] = true;
}

<section class="section">
    <div class="container">
        <h2 class="section-title">Ofertas em destaque</h2>
        <p class="section-subtitle">
            Oportunidades selecionadas para destacar os carros certos e acelerar sua próxima compra.
        </p>

        @if (Model.FeaturedVehicles.Any())
        {
            <div class="row g-4">
                @foreach (var vehicle in Model.FeaturedVehicles)
                {
                    <div class="col-lg-3 col-md-6">
                        @await Html.PartialAsync("_CatalogVehicleCardDb", vehicle)
                    </div>
                }
            </div>
        }
        else
        {
            <div class="feature-card">
                <h5 class="fw-bold mb-2">Nenhum veículo disponível</h5>
                <p class="text-muted mb-0">A vitrine da home será preenchida automaticamente quando houver veículos ativos no sistema.</p>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Catalogo" class="btn btn-outline-brand">Ver todos os veículos</a>
        </div>
    </div>
</section>

<section id="troque-seu-carro" class="section-sm">
    <div class="container">
        <div class="cta-sell">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <p class="text-uppercase fw-bold mb-2" style="letter-spacing:.08em;">Troque seu carro</p>
                    <h2 class="mb-3">Fale com um vendedor e descubra a melhor troca para você</h2>
                    <p class="mb-4 text-white-50">
                        Quer trocar de carro com praticidade? Nossa equipe ajuda você a avaliar as melhores opções e seguir o atendimento direto pelo WhatsApp.
                    </p>
                    <a href="https://wa.me/551632523490?text=Ol%C3%A1%2C%20quero%20falar%20com%20um%20vendedor%20sobre%20troca%20de%20carro." target="_blank" class="btn btn-light btn-lg fw-semibold">Falar com vendedor</a>
                </div>
                <div class="col-lg-5">
                    <div class="placeholder-box bg-white text-dark">
                        Espaço para foto do casal / cliente feliz / imagem institucional
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">Nossas lojas</h2>
        <p class="section-subtitle">
            Unidades carregadas do backend com endereço e rota direta no Google Maps.
        </p>

        @if (Model.Stores.Any())
        {
            <div class="row g-4">
                @foreach (var store in Model.Stores)
                {
                    <div class="col-lg-4">
                        <div class="feature-card">
                            <div class="store-map ratio ratio-4x3 mb-3">
                                <iframe
                                    src="@store.MapsEmbedUrl"
                                    title="Mapa @store.Nome"
                                    style="border:0;"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                            <h5 class="fw-bold">@store.Nome</h5>
                            <p class="text-muted mb-3">@store.EnderecoCompleto</p>
                            <a href="@store.MapsLinkUrl" target="_blank" class="btn btn-outline-brand">Abrir rota</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="feature-card">
                <h5 class="fw-bold mb-2">Nenhuma loja ativa encontrada</h5>
                <p class="text-muted mb-0">Cadastre e ative lojas no painel para que elas apareçam automaticamente aqui.</p>
            </div>
        }
    </div>
</section>

<style>
    .store-map {
        overflow: hidden;
        border-radius: 1rem;
        background: #f3f4f6;
    }

    .store-map iframe {
        width: 100%;
        height: 100%;
    }
</style>
