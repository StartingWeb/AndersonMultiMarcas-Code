@page
@model IndexModel
@{
    ViewData["Title"] = "Anderson Multi Marcas";
}

<article class="home-page">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active" aria-current="page">Inicio</li>
        </ol>
    </nav>

    <section class="text-center">
        <h1 class="display-5 fw-bold">Anderson Multi Marcas: carros seminovos com procedencia</h1>
