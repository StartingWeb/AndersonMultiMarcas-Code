@page "/Veiculo/Upsert/{id:int?}"
@model Project.Pages.Admin.Veiculo.UpsertModel
@using Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = Model.PageTitle;
    var br = new CultureInfo("pt-BR");
    var combustiveis = Enum.GetValues<Combustivel>().Where(x => x != Combustivel.NaoInformado);
    var cambios = Enum.GetValues<Cambio>().Where(x => x != Cambio.NaoInformado);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}

<style>
    :root {
        --brand-primary: #9f0a10;
        --brand-primary-dark: #86080d;
        --brand-dark: #222222;
        --brand-border: #ececec;
        --brand-muted: #6c757d;
        --brand-soft: rgba(159, 10, 16, 0.08);
        --brand-success: #198754;
        --brand-card-shadow: 0 8px 24px rgba(0,0,0,.05);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0;
    }

    .page-subtitle {
        font-size: .92rem;
        color: var(--brand-muted);
        margin: .2rem 0 0 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid var(--brand-border);
        border-radius: 1rem;
        box-shadow: var(--brand-card-shadow);
        overflow: hidden;
    }

    .form-card-body {
        padding: 1.25rem;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: .2rem;
    }

    .section-subtitle {
        font-size: .85rem;
        color: var(--brand-muted);
        margin-bottom: 1rem;
    }

    .form-label {
        font-size: .84rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: .35rem;
    }

    .form-help {
        display: block;
        font-size: .78rem;
        color: var(--brand-muted);
        margin-top: .4rem;
        line-height: 1.35;
    }

    .form-control,
    .form-select,
    textarea.form-control {
        border-radius: .85rem;
        border: 1px solid #e6e6e6;
        min-height: 46px;
        box-shadow: none !important;
    }

    .form-control:focus,
    .form-select:focus,
    textarea.form-control:focus {
        border-color: rgba(159, 10, 16, .35);
        box-shadow: 0 0 0 .2rem rgba(159, 10, 16, .08) !important;
    }

    textarea.form-control {
        min-height: 120px;
    }

    .text-danger {
        font-size: .8rem;
    }

    .btn-brand {
        background: var(--brand-primary);
        border-color: var(--brand-primary);
        color: #fff;
        border-radius: .85rem;
        font-weight: 600;
        min-height: 46px;
        padding: 0 1.25rem;
    }

    .btn-brand:hover {
        background: var(--brand-primary-dark);
        border-color: var(--brand-primary-dark);
        color: #fff;
    }

    .btn-soft-dark {
        background: #fff;
        border: 1px solid var(--brand-border);
        color: var(--brand-dark);
        border-radius: .85rem;
        font-weight: 600;
        min-height: 46px;
        padding: 0 1.25rem;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
    }

    .btn-soft-dark:hover {
        background: #f8f8f8;
        color: var(--brand-dark);
    }

    .btn-soft-primary {
        background: rgba(159, 10, 16, .06);
        border: 1px solid rgba(159, 10, 16, .14);
        color: var(--brand-primary);
        border-radius: .85rem;
        font-weight: 600;
        min-height: 46px;
        padding: 0 1rem;
        display: inline-flex;
        justify-content: center;
        align-items: center;
    }

    .btn-soft-primary:hover {
        background: rgba(159, 10, 16, .1);
        color: var(--brand-primary-dark);
        border-color: rgba(159, 10, 16, .22);
    }

    .switch-field {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

    .switch-wrapper {
        display: inline-flex;
        align-items: center;
        gap: .75rem;
        user-select: none;
        cursor: pointer;
        width: fit-content;
    }

    .switch-wrapper * {
        cursor: pointer !important;
    }

    .switch-input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
        pointer-events: none;
    }

    .switch-slider {
        position: relative;
        width: 52px;
        height: 30px;
        border-radius: 999px;
        background: #d9d9d9;
        transition: background-color .25s ease, box-shadow .25s ease;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);
        flex-shrink: 0;
    }

    .switch-slider::before {
        content: "";
        position: absolute;
        top: 3px;
        left: 3px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,.18);
        transition: transform .25s ease;
    }

    .switch-input:checked + .switch-slider {
        background: var(--brand-primary);
    }

    .switch-input:checked + .switch-slider::before {
        transform: translateX(22px);
    }

    .switch-input:focus + .switch-slider {
        box-shadow: 0 0 0 .2rem rgba(159, 10, 16, .15);
    }

    .switch-text {
        display: flex;
        flex-direction: column;
        gap: .1rem;
    }

    .switch-title {
        font-size: .92rem;
        font-weight: 700;
        color: var(--brand-dark);
        line-height: 1.2;
    }

    .switch-subtitle {
        font-size: .78rem;
        color: var(--brand-muted);
        line-height: 1.35;
    }

    .switch-status {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: .22rem .6rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        background: rgba(108, 117, 125, .12);
        color: var(--brand-muted);
        transition: all .2s ease;
    }

    .switch-status.active {
        background: rgba(25, 135, 84, .12);
        color: var(--brand-success);
    }

    .brand-select-group {
        display: flex;
        gap: .75rem;
        align-items: stretch;
    }

    .brand-select-group .form-select {
        flex: 1 1 auto;
    }

    .accordion-clean .accordion-item {
        border: 1px solid var(--brand-border);
        border-radius: 1rem !important;
        overflow: hidden;
        margin-bottom: .85rem;
        background: #fff;
    }

    .accordion-clean .accordion-button {
        font-weight: 700;
        color: var(--brand-dark);
        background: #fff;
        box-shadow: none !important;
        padding: 1rem 1.1rem;
    }

    .feature-accordion-header {
        display: flex;
        gap: .65rem;
        align-items: stretch;
        flex-wrap: wrap;
    }

    .feature-accordion-header .accordion-button {
        flex: 1 1 auto;
        min-width: 0;
        border-radius: 1rem 0 0 0 !important;
    }

    .feature-accordion-header .btn-selecionar-todos {
        align-self: stretch;
        border-radius: 0 1rem 0 0;
        min-height: auto;
        padding-inline: .9rem;
        white-space: nowrap;
    }

    .accordion-clean .accordion-button:not(.collapsed) {
        color: var(--brand-primary);
        background: rgba(159, 10, 16, .04);
    }

    .accordion-clean .accordion-body {
        padding: 1rem 1.1rem 1.1rem;
    }

    .feature-toolbar {
        display: flex;
        justify-content: flex-end;
        gap: .65rem;
        margin-bottom: .9rem;
    }

    .feature-toolbar-global {
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .feature-toolbar-note {
        font-size: .82rem;
        color: var(--brand-muted);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
    }

    .feature-check {
        display: flex;
        align-items: center;
        gap: .55rem;
        min-height: 44px;
        padding: .75rem .9rem;
        border: 1px solid #eee;
        border-radius: .85rem;
        background: #fff;
        transition: all .2s ease;
    }

    .feature-check:hover {
        background: #fafafa;
        border-color: #ddd;
    }

    .feature-check input[type="checkbox"] {
        transform: scale(1.08);
        accent-color: var(--brand-primary);
    }

    .feature-check label {
        font-size: .88rem;
        color: var(--brand-dark);
        cursor: pointer;
        margin: 0;
        width: 100%;
    }

    .media-dropzone {
        border: 2px dashed #d9d9d9;
        border-radius: 1rem;
        background: #fafafa;
        padding: 1.25rem;
        text-align: center;
        transition: all .2s ease;
    }

    .media-dropzone.dragover {
        border-color: var(--brand-primary);
        background: rgba(159, 10, 16, .04);
    }

    .media-dropzone-icon {
        font-size: 2rem;
        color: var(--brand-primary);
        margin-bottom: .4rem;
    }

    .media-dropzone-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: .25rem;
    }

    .media-dropzone-subtitle {
        font-size: .84rem;
        color: var(--brand-muted);
        margin-bottom: .9rem;
    }

    .media-input-hidden {
        display: none;
    }

    .media-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin-top: 1rem;
        margin-bottom: .75rem;
        flex-wrap: wrap;
    }

    .media-sort-help {
        font-size: .8rem;
        color: var(--brand-muted);
    }

    .media-list {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-top: .75rem;
    }

    .media-item {
        border: 1px solid var(--brand-border);
        border-radius: 1rem;
        background: #fff;
        overflow: hidden;
        box-shadow: var(--brand-card-shadow);
        position: relative;
        cursor: grab;
    }

    .media-item.dragging {
        opacity: .55;
        transform: scale(.98);
    }

    .media-thumb {
        width: 100%;
        height: 180px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .media-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .media-body {
        padding: .85rem;
    }

    .media-name {
        font-size: .82rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0 0 .45rem 0;
        word-break: break-word;
    }

    .media-meta {
        font-size: .76rem;
        color: var(--brand-muted);
        margin-bottom: .75rem;
    }

    .media-actions {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

    .media-badge {
        position: absolute;
        top: .75rem;
        left: .75rem;
        z-index: 2;
        background: rgba(0,0,0,.65);
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        padding: .25rem .55rem;
        border-radius: 999px;
    }

    .media-remove-btn {
        width: 100%;
        border-radius: .75rem;
    }

    .media-order-label {
        font-size: .75rem;
        color: var(--brand-muted);
        font-weight: 700;
    }

    .input-with-prefix {
        position: relative;
    }

    .input-with-prefix .prefix {
        position: absolute;
        top: 50%;
        left: 14px;
        transform: translateY(-50%);
        font-size: .9rem;
        color: var(--brand-muted);
        font-weight: 700;
        pointer-events: none;
    }

    .input-with-prefix .form-control {
        padding-left: 40px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    @@media (max-width: 1200px) {
        .media-list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .feature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .media-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .page-header,
        .form-actions,
        .media-toolbar,
        .brand-select-group {
            flex-direction: column;
            align-items: stretch;
        }

        .feature-accordion-header .accordion-button,
        .feature-accordion-header .btn-selecionar-todos {
            width: 100%;
        }

        .feature-accordion-header .accordion-button {
            border-radius: 1rem 1rem 0 0 !important;
        }

        .feature-accordion-header .btn-selecionar-todos {
            border-radius: 0 0 1rem 1rem;
        }

        .feature-grid,
        .media-list {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi @(Model.IsEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                @Model.PageTitle
            </h1>
            <p class="page-subtitle">@Model.PageSubtitle</p>
        </div>

        <a class="btn btn-soft-dark" href="/Veiculo">
            <i class="bi bi-arrow-left me-2"></i>
            Voltar
        </a>
    </div>

    <div class="form-card">
        <div class="form-card-body">
            <form method="post" enctype="multipart/form-data" id="formVeiculo" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Veiculo.Id">
                <input type="hidden" asp-for="Veiculo.Titulo">
                <input type="hidden" asp-for="MidiasOrdenadasJson" id="MidiasOrdenadasJson">
                <input type="hidden" asp-for="CapaItemKey" id="CapaItemKey">

                <div class="mb-4">
                    <div class="section-title">Dados principais</div>
                    <div class="section-subtitle">Informações básicas do veículo.</div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <label class="form-label" asp-for="Veiculo.LojaId">Loja</label>
                            <select class="form-select" asp-for="Veiculo.LojaId">
                                <option value="">Selecione</option>
                                @foreach (var loja in Model.Lojas)
                                {
                                    <option value="@loja.Id">@loja.Nome</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Veiculo.LojaId"></span>
                        </div>

                        <div class="col-12 col-lg-8">
                            <label class="form-label" asp-for="Veiculo.MarcaId">Marca</label>
                            <div class="brand-select-group">
                                <select class="form-select" asp-for="Veiculo.MarcaId">
                                    <option value="">Selecione</option>
                                    @foreach (var marca in Model.Marcas)
                                    {
                                        <option value="@marca.Id">@marca.Nome</option>
                                    }
                                </select>

                                <button type="button" style="display:none" class="btn btn-soft-primary">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    Cadastrar marca
                                </button>
                            </div>
                            <span class="text-danger" asp-validation-for="Veiculo.MarcaId"></span>
                        </div>

                        <div class="col-12 col-lg-6">
                            <label class="form-label" asp-for="Veiculo.Modelo">Modelo</label>
                            <input class="form-control" asp-for="Veiculo.Modelo" maxlength="100" placeholder="Ex.: Onix">
                            <span class="text-danger" asp-validation-for="Veiculo.Modelo"></span>
                        </div>

                        <div class="col-12 col-lg-6">
                            <label class="form-label" asp-for="Veiculo.Versao">Versão</label>
                            <input class="form-control" asp-for="Veiculo.Versao" maxlength="100" placeholder="Ex.: LTZ">
                            <span class="text-danger" asp-validation-for="Veiculo.Versao"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.AnoFabricacao">Ano fabricação</label>
                            <input class="form-control" asp-for="Veiculo.AnoFabricacao" type="number" placeholder="Ex.: 2022">
                            <span class="text-danger" asp-validation-for="Veiculo.AnoFabricacao"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.AnoModelo">Ano modelo</label>
                            <input class="form-control" asp-for="Veiculo.AnoModelo" type="number" placeholder="Ex.: 2023">
                            <span class="text-danger" asp-validation-for="Veiculo.AnoModelo"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.Cor">Cor</label>
                            <input class="form-control" asp-for="Veiculo.Cor" maxlength="30" placeholder="Ex.: Branco">
                            <span class="text-danger" asp-validation-for="Veiculo.Cor"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.Quilometragem">Quilometragem</label>
                            <input class="form-control js-mask-km" asp-for="Veiculo.Quilometragem" type="text" inputmode="numeric" maxlength="15" placeholder="Ex.: 45.000">
                            <span class="text-danger" asp-validation-for="Veiculo.Quilometragem"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.Combustivel">Combustível</label>
                            <select class="form-select" asp-for="Veiculo.Combustivel">
                                <option value="">Selecione</option>
                                @foreach (var combustivel in combustiveis)
                                {
                                    <option value="@((int)combustivel)">@combustivel</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Veiculo.Combustivel"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label" asp-for="Veiculo.Cambio">Câmbio</label>
                            <select class="form-select" asp-for="Veiculo.Cambio">
                                <option value="">Selecione</option>
                                @foreach (var cambio in cambios)
                                {
                                    <option value="@((int)cambio)">@cambio</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Veiculo.Cambio"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label" asp-for="Veiculo.Placa">Placa</label>
                            <input class="form-control js-mask-placa text-uppercase" asp-for="Veiculo.Placa" maxlength="8" placeholder="ABC1D23">
                            <span class="text-danger" asp-validation-for="Veiculo.Placa"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label" asp-for="Veiculo.PrecoVenda">Preço de venda</label>
                            <div class="input-with-prefix">
                                <span class="prefix">R$</span>
                                <input class="form-control js-mask-money" asp-for="Veiculo.PrecoVenda" type="text" inputmode="decimal" placeholder="0,00">
                            </div>
                            <span class="text-danger" asp-validation-for="Veiculo.PrecoVenda"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label" asp-for="Veiculo.Descricao">Descrição</label>
                            <textarea class="form-control" asp-for="Veiculo.Descricao" maxlength="4000" placeholder="Descreva os detalhes do veículo..."></textarea>
                            <span class="text-danger" asp-validation-for="Veiculo.Descricao"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="mb-4">
                    <div class="section-title">Status e flags</div>
                    <div class="section-subtitle">Defina disponibilidade e condicoes comerciais.</div>

                    <div class="row g-3">
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.Ativo", "Veiculo_Ativo", Model.Veiculo.Ativo, "Ativo", "Veículo disponível no sistema.", "statusVeiculoAtivo"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.Vendido", "Veiculo_Vendido", Model.Veiculo.Vendido, "Vendido", "Marca o veículo como vendido.", "statusVeiculoVendido"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.Destaque", "Veiculo_Destaque", Model.Veiculo.Destaque, "Destaque", "Prioriza o veículo na vitrine.", "statusVeiculoDestaque"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.Seminovo", "Veiculo_Seminovo", Model.Veiculo.Seminovo, "Seminovo", "Identifica como seminovo.", "statusVeiculoSeminovo"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.MotoEletrica", "Veiculo_MotoEletrica", Model.Veiculo.MotoEletrica, "Moto elétrica", "Identifica como moto elétrica.", "statusVeiculoMotoEletrica"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.AceitaTroca", "Veiculo_AceitaTroca", Model.Veiculo.AceitaTroca, "Aceita troca", "Indica negociação com troca.", "statusVeiculoAceitaTroca"))
                        @await Html.PartialAsync("_SwitchField", ("Veiculo.Financiavel", "Veiculo_Financiavel", Model.Veiculo.Financiavel, "Financiável", "Permite financiamento.", "statusVeiculoFinanciavel"))
                    </div>
                </div>

                <hr class="my-4">

                <div class="mb-4">
                    <div class="section-title">Caracteristicas</div>
                    <div class="section-subtitle">Expanda os grupos abaixo e marque o que o veículo possui.</div>

                    <div class="feature-toolbar feature-toolbar-global mt-3">
                        <span class="feature-toolbar-note">Use o atalho para preencher rapidamente um pacote basico.</span>
                        <button type="button" class="btn btn-soft-primary" id="btnBaseCarro">
                            <i class="bi bi-magic me-2"></i>
                            Base Carro
                        </button>
                    </div>

                    <div class="accordion accordion-clean" id="accordionCaracteristicas">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingConforto">
                                <div class="feature-accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConforto" aria-expanded="true">
                                        <i class="bi bi-stars me-2"></i> Conforto
