@page "/Admin/Cadastros/Marcas"
@model Project.Pages.Admin.Cadastros.Marcas.IndexModel

<style>
    :root {
        --brand-primary: #9f0a10;
        --brand-dark: #222222;
        --brand-border: #ececec;
        --brand-muted: #6c757d;
        --brand-soft: rgba(159, 10, 16, 0.08);
    }

    .page-header, .results-topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .page-title { font-size: 1.25rem; font-weight: 700; color: var(--brand-dark); margin: 0; }
    .page-subtitle, .results-counter, .muted-text { font-size: .88rem; color: var(--brand-muted); margin: .15rem 0 0; }
    .search-card, .list-card { background: #fff; border: 1px solid var(--brand-border); border-radius: 1rem; box-shadow: 0 8px 24px rgba(0,0,0,.05); }
    .search-card { margin-bottom: 1rem; }
    .search-card .card-body { padding: .9rem; }
    .filter-label { font-size: .78rem; font-weight: 700; color: var(--brand-dark); margin-bottom: .35rem; }
    .form-control, .form-select { border-radius: .75rem; border: 1px solid #e6e6e6; min-height: 42px; box-shadow: none !important; }
    .form-control:focus, .form-select:focus { border-color: rgba(159,10,16,.35); box-shadow: 0 0 0 .2rem rgba(159,10,16,.08) !important; }
    .input-icon-wrap { position: relative; }
    .input-icon-wrap i { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); color: var(--brand-muted); }
    .input-icon-wrap .form-control { padding-left: 2.4rem; }
    .btn-brand, .btn-soft-dark { border-radius: .75rem; font-weight: 600; min-height: 42px; display: inline-flex; justify-content: center; align-items: center; }
    .btn-brand { background: var(--brand-primary); border-color: var(--brand-primary); color: #fff; }
    .btn-brand:hover { background: #86080d; border-color: #86080d; color: #fff; }
    .btn-soft-dark { background: #fff; border: 1px solid var(--brand-border); color: var(--brand-dark); }
    .btn-soft-dark:hover { background: #f8f8f8; color: var(--brand-dark); }
    .btn-danger-soft { width: 42px; height: 42px; border-radius: .75rem; border: 1px solid #f4c7cb; background: #fff4f4; color: #b42318; display: inline-flex; align-items: center; justify-content: center; }
    .btn-danger-soft:hover { background: #b42318; border-color: #b42318; color: #fff; }
    .admin-table { margin: 0; vertical-align: middle; }
    .admin-table thead th { background: #f8f8f8; color: var(--brand-dark); font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--brand-border); padding: .8rem; white-space: nowrap; }
    .admin-table tbody td { padding: .72rem .8rem; border-color: #f1f1f1; color: var(--brand-dark); }
    .title-cell { display: flex; flex-direction: column; gap: .2rem; min-width: 220px; }
    .title-main { font-size: .95rem; font-weight: 700; line-height: 1.3; }
    .table-action { width: 38px; height: 38px; min-width: 38px; padding: 0; }
    .table-row-actions { display: flex; justify-content: flex-end; gap: .45rem; flex-wrap: nowrap; align-items: center; }
    .empty-state { border: 1px dashed #dadada; border-radius: 1rem; padding: 2.2rem 1.2rem; text-align: center; background: #fff; }
    .empty-state-icon { width: 64px; height: 64px; border-radius: 18px; margin: 0 auto .9rem; display: flex; align-items: center; justify-content: center; background: var(--brand-soft); color: var(--brand-primary); font-size: 1.6rem; }
    .confirm-delete-overlay { position: fixed; inset: 0; background: rgba(17,24,39,.6); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; padding: 1.25rem; z-index: 1400; }
    .confirm-delete-overlay.show { display: flex; }
    .confirm-delete-modal { width: min(100%, 460px); background: #fff; border-radius: 1.25rem; border: 1px solid rgba(159,10,16,.15); box-shadow: 0 28px 70px rgba(17,24,39,.26); overflow: hidden; }
    .confirm-delete-header { padding: 1.15rem 1.2rem 1rem; background: linear-gradient(180deg,#fff 0%,#fff8f8 100%); border-bottom: 1px solid #ececec; }
    .confirm-delete-title { margin: 0; font-size: 1.06rem; font-weight: 800; color: #1f2937; }
    .confirm-delete-body { padding: 1.1rem 1.2rem 1.2rem; color: #4b5563; line-height: 1.55; }
    .confirm-delete-actions { display: flex; justify-content: flex-end; gap: .75rem; padding: 0 1.2rem 1.2rem; flex-wrap: wrap; }
    .confirm-delete-btn-cancel, .confirm-delete-btn-confirm { min-height: 46px; padding: .75rem 1rem; border-radius: .9rem; font-weight: 700; }
    .confirm-delete-btn-cancel { border: 1px solid #e5e7eb; background: #fff; color: #1f2937; }
    .confirm-delete-btn-confirm { border: 1px solid #b42318; background: #b42318; color: #fff; }
    @@media (max-width: 768px) { .page-header, .results-topbar { flex-direction: column; align-items: stretch; } .table-row-actions { flex-direction: column; align-items: stretch; } }
</style>

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1 class="page-title"><i class="bi bi-tags-fill me-2"></i>Marcas</h1>
            <p class="page-subtitle">Lista e gerenciamento das marcas cadastradas</p>
        </div>
        <a href="/Admin/Cadastros/Marcas/Upsert" class="btn btn-brand px-3"><i class="bi bi-plus-circle me-2"></i>Nova marca</a>
    </div>

    <div class="search-card card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-8">
                        <label class="filter-label" asp-for="Filtro">Pesquisar marca</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-search"></i>
                            <input asp-for="Filtro" type="text" class="form-control" placeholder="Nome da marca">
                        </div>
                    </div>
                    <div class="col-12 col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-brand flex-fill"><i class="bi bi-search me-2"></i>Buscar</button>
                        <a class="btn btn-soft-dark flex-fill" href="/Admin/Cadastros/Marcas"><i class="bi bi-arrow-counterclockwise me-2"></i>Limpar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="results-topbar">
        <h5 class="page-title">Marcas cadastradas</h5>
        <div class="results-counter"><strong>@Model.Marcas.Count</strong> registro(s)</div>
    </div>

    @if (Model.Marcas.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-tags-fill"></i></div>
            <h2 class="page-title mb-2">Nenhuma marca encontrada</h2>
            <p class="page-subtitle mb-0">Ajuste os filtros e tente novamente.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Marca</th>
                            <th>Logo</th>
                            <th class="text-end">Acao</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var marca in Model.Marcas)
                        {
                            <tr>
                                <td>
                                    <div class="title-cell">
                                        <span class="title-main">@marca.Nome</span>
                                        <span class="muted-text">Codigo @marca.Id</span>
                                    </div>
                                </td>
                                <td><span class="muted-text">@marca.LogoUrl</span></td>
                                <td class="text-end">
                                    <div class="table-row-actions">
                                        <a class="btn btn-brand table-action" href="/Admin/Cadastros/Marcas/Upsert/@marca.Id" aria-label="Editar marca"><i class="bi bi-pencil-square"></i></a>
                                        <form method="post" class="m-0" asp-page-handler="Delete">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@marca.Id">
                                            <input type="hidden" asp-for="Filtro">
                                            <button type="button" class="btn-danger-soft table-action" data-confirm-delete data-confirm-message="Deseja excluir esta marca?" aria-label="Excluir marca"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<div id="confirmDeleteOverlay" class="confirm-delete-overlay" aria-hidden="true">
    <div class="confirm-delete-modal" role="dialog" aria-modal="true" aria-labelledby="confirmDeleteTitle">
        <div class="confirm-delete-header"><h2 id="confirmDeleteTitle" class="confirm-delete-title">Confirmar exclusao</h2></div>
        <div class="confirm-delete-body"><p id="confirmDeleteMessage" class="mb-0">Deseja excluir este registro?</p></div>
        <div class="confirm-delete-actions">
            <button type="button" id="confirmDeleteCancel" class="confirm-delete-btn-cancel">Cancelar</button>
            <button type="button" id="confirmDeleteSubmit" class="confirm-delete-btn-confirm">Excluir</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const overlay = document.getElementById('confirmDeleteOverlay');
            const message = document.getElementById('confirmDeleteMessage');
            const cancelButton = document.getElementById('confirmDeleteCancel');
            const submitButton = document.getElementById('confirmDeleteSubmit');
            let pendingForm = null;
            if (!overlay || !message || !cancelButton || !submitButton) return;
            function closeModal() { overlay.classList.remove('show'); overlay.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; pendingForm = null; }
            function openModal(form, customMessage) { pendingForm = form; message.textContent = customMessage || 'Deseja excluir este registro?'; overlay.classList.add('show'); overlay.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
            document.addEventListener('click', function (event) {
                const trigger = event.target.closest('[data-confirm-delete]');
                if (!trigger) return;
                const form = trigger.closest('form');
                if (!form) return;
                event.preventDefault();
                openModal(form, trigger.getAttribute('data-confirm-message'));
            });
            cancelButton.addEventListener('click', closeModal);
            submitButton.addEventListener('click', function () { if (pendingForm) { const form = pendingForm; closeModal(); form.submit(); } else { closeModal(); } });
            overlay.addEventListener('click', function (event) { if (event.target === overlay) closeModal(); });
            document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && overlay.classList.contains('show')) closeModal(); });
        })();
    </script>
}
