@model Project.Pages.CatalogoModel.CatalogVehicleItem

<article class="vehicle-card catalog-card">
    <a asp-page="/Veiculo" asp-route-id="@Model.Id" class="card-link-cover" aria-label="Abrir detalhes de @Model.Titulo"></a>

    <div class="vehicle-media">
        <img src="@Model.ImageUrl"
             alt="@Model.Titulo"
             class="vehicle-thumb"
             width="640"
             height="480"
             loading="lazy"
             decoding="async"
             fetchpriority="low" />
        <span class="vehicle-tag">@Model.Tag</span>
    </div>

    <div class="vehicle-body">
        <div class="vehicle-name">@Model.Titulo</div>

        @if (!string.IsNullOrWhiteSpace(Model.Highlight))
        {
            <div class="catalog-highlight-text">@Model.Highlight</div>
        }

        <div class="catalog-specs">
            <span>@Model.Cambio</span>
            <span>@Model.Combustivel</span>
        </div>

        @{
            var isZeroKm = !Model.Seminovo;
        }

        @if (isZeroKm || Model.Quilometragem.HasValue)
        {
            <div class="vehicle-meta">
                @if (isZeroKm)
                {
                    @:0 km
                }
                else
                {
                    @($"{Model.Quilometragem!.Value:N0} km rodados")
                }
            </div>
        }

        <div class="vehicle-price">
            @(Model.Preco.HasValue ? Model.Preco.Value.ToBrazilianCurrency() : "Consulte")
        </div>

        @if (Model.PrecoDe.HasValue)
        {
            <div class="catalog-price-old">De @Model.PrecoDe.Value.ToBrazilianCurrency()</div>
        }

        <div class="catalog-actions d-grid gap-2">
            <button type="button"
                    class="btn btn-outline-brand w-100"
                    data-whatsapp-modal="true"
                    data-vehicle-title="@Model.Titulo">
                Tenho interesse
            </button>
        </div>
    </div>
</article>
