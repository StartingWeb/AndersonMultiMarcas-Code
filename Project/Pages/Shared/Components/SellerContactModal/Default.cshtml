@model IReadOnlyCollection<Project.Pages.ViewModels.HomeSellerViewModel>
@functions {
    private static string FormatPhone(string phone)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());

        return digits.Length switch
        {
            10 => $"({digits[..2]}) {digits[2..6]}-{digits[6..]}",
            11 => $"({digits[..2]}) {digits[2..7]}-{digits[7..]}",
            12 when digits.StartsWith("55") => $"({digits[2..4]}) {digits[4..8]}-{digits[8..]}",
            13 when digits.StartsWith("55") => $"({digits[2..4]}) {digits[4..9]}-{digits[9..]}",
            _ => digits
        };
    }

    private static bool HasSellerPhoto(string? photoUrl)
    {
        if (string.IsNullOrWhiteSpace(photoUrl))
        {
            return false;
        }

        return SellerImageHelper.IsSellerImage(photoUrl);
    }
}
<div class="modal fade seller-contact-modal" id="sellerContactModal" tabindex="-1" aria-labelledby="sellerContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable seller-contact-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="seller-contact-heading">
                    <span class="seller-contact-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 11a7 7 0 0 1-7 7H8l-4 3v-4a7 7 0 1 1 15-6Z"></path>
                            <path d="M8.5 10.5h.01"></path>
                            <path d="M12 10.5h.01"></path>
                            <path d="M15.5 10.5h.01"></path>
                            <path d="M16.5 18.5a5.5 5.5 0 0 0 3.5 1.2h1.5l-1.2-1.8a5.4 5.4 0 0 0 .7-2.7 5.5 5.5 0 0 0-2.6-4.7"></path>
                        </svg>
                    </span>
                    <div>
                        <span class="seller-contact-kicker">Anderson Multimarcas</span>
                        <h5 class="modal-title" id="sellerContactModalLabel">Fale com um vendedor</h5>
                        <p class="seller-contact-modal-subtitle mb-0" data-seller-contact-context aria-live="polite">Escolha um contato para continuar no WhatsApp.</p>
                    </div>
                </div>
            </div>
            <div class="modal-body seller-contact-body">
                @if (Model.Count == 0)
                {
                    <div class="seller-contact-empty">
                        <strong>Nenhum vendedor disponível agora.</strong>
                        <span>Tente novamente em instantes ou fale pelo WhatsApp da loja.</span>
                    </div>
                }
                else
                {
                    <div class="seller-contact-intro">
                        <span class="seller-contact-intro-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"></path>
                                <path d="M8 9h8"></path>
                                <path d="M8 13h5"></path>
                            </svg>
                        </span>
                        <span>Atendimento humano, sem formulário. Você será direcionado para o WhatsApp do vendedor selecionado.</span>
                    </div>
                    <div class="seller-contact-list">
                        @foreach (var vendedor in Model)
                        {
                            <div class="seller-contact-card">
                                <div class="seller-contact-avatar">
                                    @if (HasSellerPhoto(vendedor.FotoUrl))
                                    {
                                        <img src="@ImageUrlBuilder.Build(vendedor.FotoUrl, 96, 65)"
                                             srcset="@ImageUrlBuilder.BuildSrcSet(vendedor.FotoUrl, 64, 96, 128)"
                                             sizes="64px"
                                             alt="@vendedor.Nome"
                                             class="seller-contact-photo"
                                             loading="lazy"
                                             decoding="async"
                                             width="64"
                                             height="64"
                                            onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                                        <span class="seller-contact-photo-fallback" hidden aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="9" cy="8" r="3"></circle>
                                                <path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path>
                                                <circle cx="17" cy="9" r="2.5"></circle>
                                                <path d="M16.5 15.5a5.5 5.5 0 0 1 5 4.5"></path>
                                            </svg>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="seller-contact-photo-fallback" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="9" cy="8" r="3"></circle>
                                                <path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path>
                                                <circle cx="17" cy="9" r="2.5"></circle>
                                                <path d="M16.5 15.5a5.5 5.5 0 0 1 5 4.5"></path>
                                            </svg>
                                        </span>
                                    }
                                </div>
                                <div class="seller-contact-details">
                                    <div class="seller-contact-name">@vendedor.Nome</div>
                                    <div class="seller-contact-role">Consultor Anderson Multimarcas</div>
                                    <div class="seller-contact-phone">
                                        <span aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.93.33 1.84.63 2.71a2 2 0 0 1-.45 2.11L8 9.84a16 16 0 0 0 6.16 6.16l1.3-1.29a2 2 0 0 1 2.11-.45c.87.3 1.78.51 2.71.63A2 2 0 0 1 22 16.92Z"></path>
                                            </svg>
                                        </span>
                                        @FormatPhone(vendedor.Telefone)
                                    </div>
                                </div>
                                <a href="https://wa.me/@vendedor.Telefone"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="seller-contact-action"
                                   data-seller-name="@vendedor.Nome"
                                   data-seller-phone="@vendedor.Telefone"
                                   aria-label="Chamar @vendedor.Nome no WhatsApp"
                                   title="Chamar no WhatsApp">
                                    <span class="seller-contact-action-icon" aria-hidden="true">
                                        <svg viewBox="0 0 32 32" fill="currentColor">
                                            <path d="M16 3C8.83 3 3 8.74 3 15.8c0 2.5.73 4.94 2.1 7.05L3 29l6.36-2.05A13.1 13.1 0 0 0 16 28.6c7.17 0 13-5.74 13-12.8S23.17 3 16 3Zm0 23.44c-2.05 0-4.06-.55-5.8-1.58l-.41-.24-3.77 1.21 1.23-3.67-.27-.43a11.26 11.26 0 0 1-1.74-5.93C5.24 9.68 9.98 5 16 5s10.76 4.68 10.76 10.8S22.02 26.44 16 26.44Zm5.9-7.85c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.74.16-.22.31-.85 1.06-1.04 1.28-.19.22-.38.25-.71.08-.33-.16-1.38-.5-2.63-1.59-.97-.84-1.62-1.88-1.82-2.19-.19-.31-.02-.48.15-.64.15-.15.33-.39.49-.58.16-.19.22-.33.33-.55.11-.22.05-.41-.03-.58-.08-.16-.74-1.78-1.01-2.44-.27-.65-.54-.56-.74-.57h-.63c-.22 0-.58.08-.88.41-.3.33-1.15 1.12-1.15 2.73s1.18 3.16 1.34 3.38c.16.22 2.31 3.68 5.6 5.15.78.34 1.39.54 1.86.69.78.25 1.49.22 2.05.13.63-.1 1.93-.79 2.2-1.55.27-.76.27-1.4.19-1.55-.08-.14-.3-.22-.63-.38Z"></path>
                                        </svg>
                                    </span>
                                    <span>Chamar</span>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            <button type="button" class="seller-contact-close" data-bs-dismiss="modal" aria-label="Fechar modal">Fechar</button>
        </div>
    </div>
</div>
