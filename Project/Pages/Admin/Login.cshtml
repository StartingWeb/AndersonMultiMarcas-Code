@page
@model Project.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
}

<style>
    .login-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        display: flex;
        justify-content: center;
    }

    .login-card {
        width: min(100%, 470px);
        max-width: 470px;
        padding: 24px;
        border-radius: 28px;
        background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,248,248,0.96) 100%);
        border: 1px solid rgba(166, 29, 36, 0.12);
        box-shadow: 0 28px 70px rgba(70, 8, 12, 0.30);
        backdrop-filter: blur(14px);
        position: relative;
        overflow: hidden;
        margin-inline: auto;
    }

    .login-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, #5f0c12 0%, #a61d24 55%, #dc3545 100%);
    }

    .login-header {
        text-align: center;
        margin-bottom: 18px;
    }

    .login-header span {
        display: inline-block;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #9f0a10;
        margin-bottom: 0;
    }

    .validation-summary-box {
        margin-bottom: 18px;
        padding: 12px 14px;
        border-radius: 16px;
        border: 1px solid #f1b7bc;
        background: #fff4f4;
    }

    .validation-summary-errors ul,
    .validation-summary-valid ul {
        margin: 0;
        padding-left: 18px;
        color: #b42318;
        font-size: 13px;
    }

    .form-group-modern {
        margin-bottom: 18px;
    }

    .form-label-modern {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #27272a;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #8a8f98;
        pointer-events: none;
    }

    .input-icon svg {
        width: 18px;
        height: 18px;
        display: block;
        stroke: currentColor;
    }

    .form-control-modern {
        width: 100%;
        max-width: 100%;
        height: 56px;
        padding: 0 16px 0 46px;
        border-radius: 16px;
        border: 1px solid #ead3d5;
        background: #fff;
        color: #18181b;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        box-sizing: border-box;
    }

    .form-control-modern:focus {
        border-color: #9f0a10;
        box-shadow: 0 0 0 4px rgba(159, 10, 16, 0.10);
    }

    .toggle-password {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 8px;
        cursor: pointer;
    }

    .toggle-password:hover {
        color: #9f0a10;
    }

    .login-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 8px 0 22px;
    }

    .remember-check {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #52525b;
        cursor: pointer;
    }

    .remember-check input {
        width: 16px;
        height: 16px;
        accent-color: #9f0a10;
    }

    .btn-login-modern {
        width: 100%;
        height: 56px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(90deg, #5f0c12 0%, #9f0a10 58%, #c81d25 100%);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        transition: transform .18s ease, box-shadow .18s ease;
        box-shadow: 0 16px 32px rgba(159, 10, 16, 0.24);
    }

    .btn-login-modern:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 20px 36px rgba(159, 10, 16, 0.28);
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        color: #b42318;
    }

    .login-help {
        margin-top: 18px;
        text-align: center;
        font-size: 13px;
        color: #6b7280;
    }

    .login-help a {
        color: #9f0a10;
        font-weight: 700;
        text-decoration: none;
    }

    .login-help a:hover {
        color: #6f1016;
    }

    @@media (max-width: 576px) {
        .login-card {
            width: 100%;
            max-width: 100%;
            padding: 24px 16px 20px;
            border-radius: 22px;
        }

        .toggle-password {
            right: 6px;
            padding: 6px;
        }
    }
</style>

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <span>Area Administrativa</span>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-box text-danger"></div>

        <form method="post" novalidate>
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="form-group-modern">
                <label asp-for="Input.Email" class="form-label-modern">E-mail</label>
                <div class="input-wrapper">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 6h16v12H4z"></path>
                            <path d="m4 7 8 6 8-6"></path>
                        </svg>
                    </span>
                    <input asp-for="Input.Email"
                           class="form-control-modern"
                           placeholder="seuemail@empresa.com"
                           autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <div class="form-group-modern">
                <label asp-for="Input.Password" class="form-label-modern">Senha</label>
                <div class="input-wrapper">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                            <path d="M8 11V8a4 4 0 1 1 8 0v3"></path>
                        </svg>
                    </span>
                    <input asp-for="Input.Password"
                           id="passwordInput"
                           type="password"
                           class="form-control-modern"
                           placeholder="Digite sua senha"
                           autocomplete="current-password" />
                    <button type="button" class="toggle-password" onclick="togglePassword(this)">
                        Mostrar
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="login-options">
                <label class="remember-check">
                    <input asp-for="Input.RememberMe" />
                    <span>Lembrar acesso</span>
                </label>
            </div>

            <button type="submit" class="btn-login-modern">Entrar</button>
        </form>

        <div class="login-help">
            Voltar para o site:
            <a asp-page="/Index">Anderson Multimarcas</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(button) {
            const input = document.getElementById('passwordInput');

            if (input.type === 'password') {
                input.type = 'text';
                button.textContent = 'Ocultar';
            } else {
                input.type = 'password';
                button.textContent = 'Mostrar';
            }
        }
    </script>
}
