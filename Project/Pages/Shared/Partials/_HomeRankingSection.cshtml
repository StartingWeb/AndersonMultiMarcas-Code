@model Project.Pages.ViewModels.HomeRankingSectionViewModel
@{
    var items = Model.Itens.Take(6).ToList();
}
<section class="section home-ranking-section">
    <div class="container">
        <div class="home-ranking-shell">
            <div class="home-ranking-header">
                <div>
                    <span class="home-featured-kicker">@Model.Kicker</span>
                    <h2 class="section-title mb-0">@Model.Titulo</h2>
                    <p class="section-subtitle mb-0">@Model.Descricao</p>
                </div>
                <a class="btn btn-outline-brand" href="@Model.Link">Ver estoque</a>
            </div>

            @if (items.Count > 0)
            {
                <div class="home-ranking-grid">
                    @foreach (var item in items)
                    {
                        var imageSrc = VehicleImageHelper.Normalize(item.MidiaUrl);
                        var optimizedFallback = ImageUrlBuilder.Build(VehicleImageHelper.DefaultVehicleImage, 320, 62);
                        var metricValue = Model.MetricClass == "cliques" ? item.Cliques : item.Visualizacoes;
                        <a class="home-ranking-card" href="/veiculo/@item.Id/" data-track-vehicle-click="true" data-vehicle-id="@item.Id">
                            <div class="home-ranking-thumb is-loading">
                                <img src="@ImageUrlBuilder.Build(imageSrc, 320, 62)"
                                     srcset="@ImageUrlBuilder.BuildSrcSet(imageSrc, 240, 320, 480)"
                                     alt="@item.Titulo"
                                     data-progressive-image="true"
                                     loading="lazy"
                                     decoding="async"
                                     fetchpriority="auto"
                                     onerror="this.onerror=null;this.removeAttribute('srcset');this.src='@optimizedFallback';" />
                            </div>
                            <div class="home-ranking-copy">
                                <div class="home-ranking-badge">@metricValue @Model.MetricLabel</div>
                                <strong>@item.Titulo</strong>
                                <span>@item.Cor - @item.AnoExibicao</span>
                            </div>
                            <i class="bi bi-arrow-right home-ranking-arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="home-ranking-empty">
                    Nenhum veículo disponível para este ranking no momento.
                </div>
            }
        </div>
    </div>
</section>
