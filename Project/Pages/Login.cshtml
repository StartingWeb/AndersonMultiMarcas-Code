@page "/Login"
@model Project.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Area Administrativa";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] - Anderson Multimarcas</title>
    <link rel="icon" type="image/x-icon" href="~/favicon/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #140608;
        }

        .message-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }

        .message-toast {
            width: 360px;
            min-height: 72px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .12);
            overflow: hidden;
            display: flex;
            align-items: stretch;
            pointer-events: auto;
            transform: translateX(420px);
            opacity: 0;
            transition: transform .35s ease, opacity .35s ease;
            border: 1px solid #ececec;
            position: relative;
        }

        .message-toast.show {
            transform: translateX(0);
            opacity: 1;
        }

        .message-toast.hide {
            transform: translateX(420px);
            opacity: 0;
        }

        .message-toast-icon {
            width: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .message-toast.success .message-toast-icon {
            background: #eafaf0;
            color: #1f9d55;
        }

        .message-toast.error .message-toast-icon {
            background: #fdecec;
            color: #d93025;
        }

        .message-toast.warning .message-toast-icon {
            background: #fff7e6;
            color: #f59e0b;
        }

        .message-toast-body {
            flex: 1;
            padding: 14px 12px 14px 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .message-toast-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 4px;
        }

        .message-toast-title {
            font-size: 15px;
            font-weight: 700;
            color: #1f2937;
            margin: 0;
        }

        .message-toast-text {
            font-size: 14px;
            color: #4b5563;
            line-height: 1.4;
            margin: 0;
            word-break: break-word;
        }

        .message-toast-close {
            background: transparent;
            border: none;
            cursor: pointer;
            color: #6b7280;
            font-size: 18px;
            line-height: 1;
            padding: 0;
            width: 24px;
            height: 24px;
            border-radius: 6px;
        }

        .message-toast-close:hover {
            background: #f3f4f6;
        }

        .message-toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 100%;
            transform-origin: left;
            animation: toast-progress linear forwards;
        }

        .message-toast.success .message-toast-progress {
            background: #1f9d55;
        }

        .message-toast.error .message-toast-progress {
            background: #d93025;
        }

        .message-toast.warning .message-toast-progress {
            background: #f59e0b;
        }

        @@keyframes toast-progress {
            from {
                transform: scaleX(1);
            }

            to {
                transform: scaleX(0);
            }
        }

        .login-shell {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .login-shell::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(135deg, rgba(20, 6, 8, .82), rgba(95, 12, 18, .46) 48%, rgba(20, 6, 8, .72));
        }

        .login-main {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        .login-container {
            width: min(100%, 520px);
            margin-inline: auto;
        }

        .login-page {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            display: flex;
            justify-content: center;
        }

        .login-card {
            width: min(100%, 470px);
            max-width: 470px;
            padding: 24px;
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 248, 248, 0.96) 100%);
            border: 1px solid rgba(166, 29, 36, 0.12);
            box-shadow: 0 28px 70px rgba(70, 8, 12, 0.30);
            backdrop-filter: blur(14px);
            position: relative;
            overflow: hidden;
            margin-inline: auto;
        }

        .login-card::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, #5f0c12 0%, #a61d24 55%, #dc3545 100%);
        }

        .login-header {
            text-align: center;
            margin-bottom: 18px;
        }

        .login-header span {
            display: inline-block;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #9f0a10;
            margin-bottom: 0;
        }

        .validation-summary-box {
            margin-bottom: 18px;
            padding: 12px 14px;
            border-radius: 16px;
            border: 1px solid #f1b7bc;
            background: #fff4f4;
        }

        .validation-summary-errors ul,
        .validation-summary-valid ul {
            margin: 0;
            padding-left: 18px;
            color: #b42318;
            font-size: 13px;
        }

        .form-group-modern {
            margin-bottom: 18px;
        }

        .form-label-modern {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #27272a;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: #8a8f98;
            pointer-events: none;
        }

        .input-icon svg {
            width: 18px;
            height: 18px;
            display: block;
            stroke: currentColor;
        }

        .form-control-modern {
            width: 100%;
            max-width: 100%;
            height: 56px;
            padding: 0 16px 0 46px;
            border-radius: 16px;
            border: 1px solid #ead3d5;
            background: #fff;
            color: #18181b;
            outline: none;
            transition: border-color .2s ease, box-shadow .2s ease;
            box-sizing: border-box;
        }

        .form-control-modern:focus {
            border-color: #9f0a10;
            box-shadow: 0 0 0 4px rgba(159, 10, 16, 0.10);
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #6b7280;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 8px;
            cursor: pointer;
        }

        .toggle-password:hover {
            color: #9f0a10;
        }

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 8px 0 22px;
        }

        .remember-check {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #52525b;
            cursor: pointer;
        }

        .remember-check input {
            width: 16px;
            height: 16px;
            accent-color: #9f0a10;
        }

        .btn-login-modern {
            width: 100%;
            height: 56px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(90deg, #5f0c12 0%, #9f0a10 58%, #c81d25 100%);
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            transition: transform .18s ease, box-shadow .18s ease;
            box-shadow: 0 16px 32px rgba(159, 10, 16, 0.24);
        }

        .btn-login-modern:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 20px 36px rgba(159, 10, 16, 0.28);
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            font-size: 12px;
            color: #b42318;
        }

        .login-help {
            margin-top: 18px;
            text-align: center;
            font-size: 13px;
            color: #6b7280;
        }

        .login-help a {
            color: #9f0a10;
            font-weight: 700;
            text-decoration: none;
        }

        .login-help a:hover {
            color: #6f1016;
        }

        @@media (max-width: 576px) {
            .login-shell {
                padding: 16px;
            }

            .login-card {
                width: 100%;
                max-width: 100%;
                padding: 24px 16px 20px;
                border-radius: 22px;
            }

            .toggle-password {
                right: 6px;
                padding: 6px;
            }
        }

        @@media (max-width: 480px) {
            .message-container {
                left: 12px;
                right: 12px;
                top: 12px;
            }

            .message-toast {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div id="message-container" class="message-container"></div>

    <div class="login-shell">
        <video class="login-video" autoplay muted loop playsinline webkit-playsinline="true" preload="auto" data-autoplay-video>
            <source src="/video/videoHome.mp4" type="video/mp4" />
        </video>

        <main class="login-main">
            <div class="login-container">
                <div class="login-page">
                    <div class="login-card">
                        <div class="login-header">
                            <span>Area Administrativa</span>
                        </div>

                        <form method="post" novalidate>
                            <input asp-for="ReturnUrl" type="hidden" />

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="validation-summary-box">
                                    <div asp-validation-summary="ModelOnly"></div>
                                </div>
                            }

                            <div class="form-group-modern">
                                <label class="form-label-modern" asp-for="Input.Email"></label>
                                <div class="input-wrapper">
                                    <span class="input-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 6h16v12H4z"></path>
                                            <path d="m4 7 8 6 8-6"></path>
                                        </svg>
                                    </span>
                                    <input class="form-control-modern" asp-for="Input.Email" placeholder="seuemail@empresa.com" autocomplete="username" />
                                </div>
                                <span asp-validation-for="Input.Email"></span>
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern" asp-for="Input.Password"></label>
                                <div class="input-wrapper">
                                    <span class="input-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                                            <path d="M8 11V8a4 4 0 1 1 8 0v3"></path>
                                        </svg>
                                    </span>
                                    <input id="passwordInput" class="form-control-modern" asp-for="Input.Password" placeholder="Digite sua senha" autocomplete="current-password" />
                                    <button type="button" class="toggle-password" onclick="togglePassword(this)">Mostrar</button>
                                </div>
                                <span asp-validation-for="Input.Password"></span>
                            </div>

                            <div class="login-options">
                                <label class="remember-check">
                                    <input asp-for="Input.RememberMe" />
                                    <span>Lembrar acesso</span>
                                </label>
                            </div>

                            <button type="submit" class="btn-login-modern">Entrar</button>
                        </form>

                        <div class="login-help">
                            Voltar para o site:
                            <a href="/">Anderson Multimarcas</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const container = document.getElementById('message-container');

            const titles = {
                success: 'Sucesso',
                error: 'Erro',
                warning: 'Aviso'
            };

            const icons = {
                success: `
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M20 7L10 17L4 11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                `,
                error: `
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M12 8V12M12 16H12.01M10.29 3.86L1.82 18A2 2 0 0 0 3.53 21H20.47A2 2 0 0 0 22.18 18L13.71 3.86A2 2 0 0 0 10.29 3.86Z"
                              stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                `,
                warning: `
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M12 9V13M12 17H12.01M10.29 3.86L1.82 18A2 2 0 0 0 3.53 21H20.47A2 2 0 0 0 22.18 18L13.71 3.86A2 2 0 0 0 10.29 3.86Z"
                              stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                `
            };

            function normalizeType(type) {
                if (!type) return 'success';

                type = type.toString().toLowerCase();

                if (type === 'success') return 'success';
                if (type === 'error') return 'error';
                if (type === 'warning') return 'warning';

                return 'success';
            }

            function closeToast(toast) {
                if (!toast) return;

                toast.classList.remove('show');
                toast.classList.add('hide');

                setTimeout(() => {
                    toast.remove();
                }, 350);
            }

            window.ShowMessage = function (type, message, duration) {
                type = normalizeType(type);
                duration = duration || 4000;

                if (!message) return;

                const toast = document.createElement('div');
                toast.className = `message-toast ${type}`;

                toast.innerHTML = `
                    <div class="message-toast-icon">
                        ${icons[type]}
                    </div>
                    <div class="message-toast-body">
                        <div class="message-toast-header">
                            <h4 class="message-toast-title">${titles[type]}</h4>
                            <button type="button" class="message-toast-close" aria-label="Fechar">&times;</button>
                        </div>
                        <p class="message-toast-text"></p>
                    </div>
                    <div class="message-toast-progress" style="animation-duration:${duration}ms;"></div>
                `;

                toast.querySelector('.message-toast-text').textContent = message;

                toast.querySelector('.message-toast-close').addEventListener('click', function () {
                    closeToast(toast);
                });

                container.appendChild(toast);

                requestAnimationFrame(() => {
                    toast.classList.add('show');
                });

                setTimeout(() => {
                    closeToast(toast);
                }, duration);
            };

            const successMessage = @Json.Serialize(TempData["SuccessMessage"]);
            const errorMessage = @Json.Serialize(TempData["ErrorMessage"]);
            const warningMessage = @Json.Serialize(TempData["WarningMessage"]);

            if (successMessage) window.ShowMessage('Success', successMessage);
            if (errorMessage) window.ShowMessage('Error', errorMessage);
            if (warningMessage) window.ShowMessage('Warning', warningMessage);
        })();

        function togglePassword(button) {
            const input = document.getElementById('passwordInput');

            if (input.type === 'password') {
                input.type = 'text';
                button.textContent = 'Ocultar';
            } else {
                input.type = 'password';
                button.textContent = 'Mostrar';
            }
        }
    </script>
</body>
</html>
