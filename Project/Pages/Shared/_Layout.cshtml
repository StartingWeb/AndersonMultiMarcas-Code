@{
    var title = ViewData["Title"] as string ?? "Anderson Multimarcas";
    var showHero = ViewData["ShowHero"] as bool? ?? true;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Anderson Multimarcas</title>
    <meta name="description" content="Anderson Multimarcas - veículos seminovos e zero km com atendimento personalizado em Taquaritinga/SP." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Layout.css" />
    <link rel="stylesheet" href="~/css/VehicleCard.css" />
</head>
<body id="topo">

    <nav id="mainNavbar" class="main-navbar">
        <div class="container d-flex align-items-center justify-content-between flex-wrap">
            <a class="navbar-brand-custom" asp-page="/Index">
                <img src="/img/logo.png" alt="Anderson Multimarcas" />
            </a>

            <button class="navbar-mobile-toggle" type="button" id="mobileMenuToggle">☰</button>

            <div class="nav-menu-wrap" id="mobileMenu">
                <ul class="nav-menu ms-lg-auto">
                    <li><a asp-page="/Index">Início</a></li>
                    <li><a asp-page="/Catalogo">Estoque</a></li>
                    <li><a asp-page="/Index" asp-fragment="troque-seu-carro">Troque seu carro</a></li>
                    <li><a asp-page="/Empresa">Quem somos</a></li>
                    <li><a asp-page="/Contato">Contato</a></li>
                </ul>
            </div>
        </div>
    </nav>

    @if (showHero)
    {
        <section id="heroSection" class="hero">
            <video class="hero-video" autoplay muted loop playsinline>
                <source src="/video/videoHome.mp4" type="video/mp4" />
                Seu navegador não suporta vídeo em HTML5.
            </video>

            <div class="hero-overlay"></div>

            <div class="container hero-content">
                <div class="hero-search-modal">
                    <div class="search-box">
                        <div class="text-center mb-4">
                            <img src="/img/logo.png"
                                 alt="Anderson Multimarcas"
                                 class="img-fluid"
                                 style="max-width: 240px; width: 100%; filter: drop-shadow(0 10px 25px rgba(0,0,0,.18));" />

                            <div class="search-title mt-3 mb-0">Encontre seu veículo</div>
                            <p class="search-subtitle mb-0">Pesquise de forma ampla por marca, modelo ou ano.</p>
                        </div>

                        <partial name="_SiteSearchAutocomplete" />
                    </div>
                </div>
            </div>
        </section>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="footer mt-5 pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3">
                    <div class="footer-brand mb-3">Anderson Multimarcas</div>
                    <p class="footer-tagline">Casa de amigos, lugar de bons negócios</p>
                </div>

                <div class="col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Navegação</h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-page="/Index">Início</a>
                        <a asp-page="/Catalogo">Estoque</a>
                        <a asp-page="/Empresa">Quem somos</a>
                        <a asp-page="/Contato">Contato</a>
                    </div>
                </div>

                <div class="col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Redes sociais</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="https://www.instagram.com/andersonmultimarcastq/" target="_blank" rel="noopener noreferrer" class="footer-social-link">
                            <span class="footer-social-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <circle cx="17.5" cy="6.5" r="1"></circle>
                                </svg>
                            </span>
                            <span>Instagram</span>
                        </a>
                        <a href="https://www.facebook.com/AndersonMultimarcasTaqua" target="_blank" rel="noopener noreferrer" class="footer-social-link">
                            <span class="footer-social-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.2-1.5 1.5-1.5H16V5.1c-.2 0-.9-.1-1.8-.1-1.8 0-3 .9-3 3.3V11H9v3h2.4v7h2.1z"></path>
                                </svg>
                            </span>
                            <span>Facebook</span>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Contato</h6>
                    <div class="d-flex flex-column gap-2">
                        <span>Taquaritinga/SP</span>
                        <a href="tel:+551632523490">(16) 3252-3490</a>
                        <a href="https://wa.me/551632523490" target="_blank">WhatsApp</a>
                        <a href="mailto:contato@andersonmultimarcas.com.br">contato@andersonmultimarcas.com.br</a>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <small>© @DateTime.Now.Year Anderson Multimarcas. Todos os direitos reservados.</small>
                <a class="text-white-50 fw-semibold small" href="/Admin/Login">Área restrita</a>
            </div>
        </div>
    </footer>

    <button id="btnTop" class="floating-btn floating-top" type="button" aria-label="Voltar ao topo" title="Voltar ao topo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6"></path>
        </svg>
    </button>

    <a id="btnWhatsapp" class="floating-btn floating-whatsapp" href="https://wa.me/551632523490" target="_blank" aria-label="WhatsApp" title="WhatsApp">
        <svg viewBox="0 0 32 32" fill="currentColor">
            <path d="M19.11 17.34c-.27-.14-1.57-.77-1.81-.86-.24-.09-.41-.14-.59.14-.18.27-.68.86-.84 1.04-.15.18-.31.2-.58.07-.27-.14-1.12-.41-2.14-1.32-.79-.7-1.33-1.56-1.49-1.83-.15-.27-.02-.41.12-.54.12-.12.27-.31.41-.46.14-.15.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.59-1.42-.8-1.95-.21-.5-.43-.43-.59-.44h-.5c-.18 0-.48.07-.73.34-.25.27-.96.93-.96 2.28 0 1.35.98 2.66 1.12 2.84.14.18 1.93 2.95 4.67 4.13.65.28 1.16.44 1.56.56.66.21 1.26.18 1.74.11.53-.08 1.57-.64 1.79-1.27.22-.63.22-1.17.15-1.28-.07-.11-.25-.18-.52-.32z"></path>
            <path d="M16.01 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.25.58 4.45 1.69 6.39L3.2 28.8l6.57-1.67c1.87 1.02 3.97 1.56 6.24 1.56h.01c7.07 0 12.8-5.73 12.8-12.8S23.09 3.2 16.01 3.2zm0 23.35h-.01c-1.92 0-3.8-.52-5.45-1.5l-.39-.23-3.9.99 1.04-3.8-.25-.39a10.6 10.6 0 0 1-1.63-5.71c0-5.88 4.78-10.66 10.66-10.66 2.85 0 5.53 1.11 7.54 3.12a10.59 10.59 0 0 1 3.12 7.53c0 5.88-4.78 10.65-10.65 10.65z"></path>
        </svg>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const navbar = document.getElementById('mainNavbar');
            const hero = document.getElementById('heroSection');
            const btnTop = document.getElementById('btnTop');
            const btnWhatsapp = document.getElementById('btnWhatsapp');
            const mobileToggle = document.getElementById('mobileMenuToggle');
            const mobileMenu = document.getElementById('mobileMenu');

            function handleScroll() {
                const heroHeight = hero ? hero.offsetHeight - 80 : 500;
                const scrollY = window.scrollY;

                if (scrollY > heroHeight) {
                    navbar.classList.add('show');
                } else {
                    navbar.classList.remove('show');
                    if (mobileMenu) {
                        mobileMenu.classList.remove('show');
                    }
                }

                if (scrollY > 250) {
                    btnTop.classList.add('show');
                    btnWhatsapp.classList.add('show');
                } else {
                    btnTop.classList.remove('show');
                    btnWhatsapp.classList.remove('show');
                }
            }

            const showHero = @(showHero.ToString().ToLower());
            if(showHero)
            {
                window.addEventListener('scroll', handleScroll);
                window.addEventListener('load', handleScroll);
                window.addEventListener('resize', handleScroll);
            }
            else
            {
                navbar.classList.add('show');
            }
            

            btnTop.addEventListener('click', function () {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            if (mobileToggle && mobileMenu) {
                mobileToggle.addEventListener('click', function () {
                    mobileMenu.classList.toggle('show');
                });
            }

            document.querySelectorAll('[data-search-autocomplete]').forEach(function (root) {
                const input = root.querySelector('[data-search-input]');
                const results = root.querySelector('[data-search-results]');
                const resultsBody = root.querySelector('[data-search-results-body]');
                const endpoint = root.getAttribute('data-endpoint');

                if (!input || !results || !resultsBody || !endpoint) {
                    return;
                }

                let controller = null;

                function hideResults() {
                    results.hidden = true;
                    input.setAttribute('aria-expanded', 'false');
                    resultsBody.innerHTML = '';
                }

                function showResults() {
                    results.hidden = false;
                    input.setAttribute('aria-expanded', 'true');
                }

                function renderSuggestions(items) {
                    resultsBody.innerHTML = '';

                    if (!items || !items.length) {
                        hideResults();
                        return;
                    }

                    let currentGroup = '';

                    items.forEach(function (item) {
                        if (item.group !== currentGroup) {
                            currentGroup = item.group;

                            const groupTitle = document.createElement('div');
                            groupTitle.className = 'site-search-group-title';
                            groupTitle.textContent = item.group;
                            resultsBody.appendChild(groupTitle);
                        }

                        const link = document.createElement('a');
                        link.className = 'site-search-item';
                        link.href = item.url;

                        const icon = document.createElement('span');
                        icon.className = 'site-search-item-icon';
                        icon.innerHTML = `
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-3.5-3.5"></path>
                            </svg>`;

                        const content = document.createElement('span');
                        content.className = 'site-search-item-content';

                        const label = document.createElement('span');
                        label.className = 'site-search-item-label';
                        label.textContent = item.label;
                        content.appendChild(label);

                        if (item.meta) {
                            const meta = document.createElement('span');
                            meta.className = 'site-search-item-meta';
                            meta.textContent = item.meta;
                            content.appendChild(meta);
                        }

                        link.appendChild(icon);
                        link.appendChild(content);

                        link.addEventListener('click', function () {
                            input.value = item.query || item.label || '';
                            hideResults();
                        });

                        resultsBody.appendChild(link);
                    });

                    showResults();
                }

                async function fetchSuggestions(value) {
                    if (!value || value.trim().length < 2) {
                        hideResults();
                        return;
                    }

                    if (controller) {
                        controller.abort();
                    }

                    controller = new AbortController();

                    try {
                        const response = await fetch(endpoint + '&term=' + encodeURIComponent(value.trim()), {
                            signal: controller.signal,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            hideResults();
                            return;
                        }

                        const data = await response.json();
                        renderSuggestions(data);
                    } catch (error) {
                        if (error && error.name === 'AbortError') {
                            return;
                        }

                        hideResults();
                    }
                }

                input.addEventListener('input', function () {
                    fetchSuggestions(input.value);
                });

                input.addEventListener('focus', function () {
                    if (resultsBody.children.length > 0) {
                        showResults();
                    }
                });

                document.addEventListener('click', function (event) {
                    if (!root.contains(event.target)) {
                        hideResults();
                    }
                });
            });
        })();
    </script>

    

    @RenderSection("Scripts", required: false)
</body>
</html>
