@page
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Acesso negado";
}

<section class="container py-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 520px;">
        <div class="card-body p-4 p-md-5 text-center">
            <h1 class="h4 fw-bold mb-3">Acesso negado</h1>
            <p class="text-muted mb-4">Seu perfil atual não possui permissão para acessar esta área.</p>
            <a asp-page="/Admin/Index" class="btn btn-dark">Voltar ao painel</a>
        </div>
    </div>
</section>
