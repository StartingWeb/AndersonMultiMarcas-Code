@using Domain.Application
@using Microsoft.AspNetCore.Identity
@inject UserManager<AspNetCoreUser> UserManager
@inject RoleManager<IdentityRole<Guid>> RoleManager

@{
    var title = (ViewData["Title"] as string) ?? "Painel administrativo";
    var path = Context.Request.Path.Value ?? string.Empty;
    var isDeveloper = User.IsInRole("Desenvolvedor");
    var allowedMenuIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var hasAnyConfiguredMenu = false;

    var currentUser = await UserManager.GetUserAsync(User);
    var roleNames = currentUser is null
        ? []
        : await UserManager.GetRolesAsync(currentUser);

    foreach (var roleName in roleNames)
    {
        var role = await RoleManager.FindByNameAsync(roleName);
        if (role is null)
        {
            continue;
        }

        var claims = await RoleManager.GetClaimsAsync(role);
        var menuClaims = claims.Where(x => x.Type == AdminMenuCatalog.ClaimType).ToList();

        if (menuClaims.Count > 0)
        {
            hasAnyConfiguredMenu = true;
        }

        foreach (var claim in menuClaims)
        {
            allowedMenuIds.Add(claim.Value);
        }
    }

    bool CanShowMenu(AdminMenuItem item)
    {
        if (hasAnyConfiguredMenu)
        {
            return allowedMenuIds.Contains(item.Id);
        }

        if (isDeveloper)
        {
            return true;
        }

        return !item.DeveloperOnly;
    }

    bool IsMenuActive(AdminMenuItem item)
        => item.ExactMatch
            ? path.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@title - Anderson Multimarcas</title>
    <link rel="icon" type="image/x-icon" href="~/favicon/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --admin-ink: #1f2328;
            --admin-muted: #69727d;
            --admin-brand: #9f0a10;
            --admin-border: #e7e2dc;
            --admin-paper: #ffffff;
            --admin-bg: #ffffff;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--admin-bg);
            color: var(--admin-ink);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .admin-app {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 288px minmax(0, 1fr);
            transition: grid-template-columns .24s ease;
        }

        body.admin-sidebar-collapsed .admin-app {
            grid-template-columns: 92px minmax(0, 1fr);
        }

        .admin-sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 12px;
            background: #181818;
            color: #fff;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            will-change: transform;
        }

        .admin-brand {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
            padding: 8px 8px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, .12);
            min-height: 70px;
        }

        .admin-brand-main {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
        }

        .admin-menu-toggle-sidebar {
            align-self: center;
            margin-left: 0;
        }

        .admin-brand img {
            width: 44px;
            height: 44px;
            border-radius: 999px;
            object-fit: contain;
            background: #fff;
            padding: 4px;
        }

        .admin-brand strong {
            display: block;
            line-height: 1.1;
        }

        .admin-brand span {
            display: block;
            color: rgba(255, 255, 255, .62);
            font-size: .76rem;
        }

        body.admin-sidebar-collapsed .admin-brand {
            align-items: center;
            padding-inline: 0;
        }

        body.admin-sidebar-collapsed .admin-brand-main {
            display: none;
        }

        body.admin-sidebar-collapsed .admin-brand-copy,
        body.admin-sidebar-collapsed .admin-nav-title,
        body.admin-sidebar-collapsed .admin-nav-link span,
        body.admin-sidebar-collapsed .admin-sidebar-logout span,
        body.admin-sidebar-collapsed .admin-sidebar-user {
            display: none;
        }

        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 10px 0;
            flex: 1;
            align-content: start;
        }

        .admin-nav-title {
            padding: 10px 10px 2px;
            color: rgba(255, 255, 255, .52);
            font-size: .68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .admin-nav-link {
            display: grid;
            grid-template-columns: 20px minmax(0, 1fr);
            align-items: center;
            column-gap: 9px;
            min-height: 38px;
            padding: 8px 10px;
            border-radius: 10px;
            color: rgba(255, 255, 255, .78);
            text-decoration: none;
            font-weight: 700;
            font-size: .92rem;
        }

        .admin-nav-link i {
            font-size: .96rem;
            line-height: 1;
            text-align: center;
        }

        .admin-nav-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, .08);
        }

        .admin-nav-link.active {
            color: #fff;
            background: linear-gradient(90deg, #2a2a2a 0%, var(--admin-brand) 100%);
            box-shadow: 0 10px 22px rgba(159, 10, 16, .25);
        }

        body.admin-sidebar-collapsed .admin-nav-link {
            grid-template-columns: 1fr;
            justify-items: center;
            padding-inline: 0;
        }

        .admin-sidebar-footer {
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, .12);
            display: grid;
            gap: 8px;
        }

        .admin-sidebar-user {
            padding: 10px;
            border-radius: 12px;
            background: rgba(255, 255, 255, .06);
            border: 1px solid rgba(255, 255, 255, .08);
        }

        .admin-sidebar-user strong {
            display: block;
            font-size: .86rem;
        }

        .admin-sidebar-user span {
            display: block;
            color: rgba(255, 255, 255, .6);
            font-size: .72rem;
        }

        .admin-sidebar-logout {
            width: 100%;
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid #ffcccc;
            background: #fff3f3;
            color: var(--admin-brand);
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: .9rem;
        }

        .admin-sidebar-logout i {
            font-size: 1rem;
        }

        body.admin-sidebar-collapsed .admin-sidebar-logout {
            padding-inline: 0;
        }

        .admin-main {
            min-width: 0;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr) auto;
        }

        .admin-topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            min-height: 68px;
            padding: 12px 20px;
            background: rgba(255, 255, 255, .92);
            border-bottom: 1px solid var(--admin-border);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .admin-menu-toggle {
            width: 42px;
            height: 42px;
            border: 1px solid var(--admin-border);
            border-radius: 12px;
            background: #fff;
            color: var(--admin-ink);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .admin-menu-toggle-mobile {
            display: none;
        }

        .admin-title {
            display: grid;
            gap: 2px;
        }

        .admin-title strong {
            font-size: 1.05rem;
        }

        .admin-title span {
            color: var(--admin-muted);
            font-size: .86rem;
        }

        .admin-user-pill {
            padding: .5rem .72rem;
            border-radius: 999px;
            background: #fff;
            border: 1px solid var(--admin-border);
            font-weight: 800;
            color: var(--admin-ink);
            font-size: .88rem;
        }

        .admin-content {
            min-width: 0;
            padding: 22px;
        }

        .admin-footer {
            padding: 14px 22px 20px;
            color: var(--admin-muted);
            font-size: .86rem;
        }

        .admin-mobile-overlay {
            display: none;
        }

        @@media (max-width: 980px) {
            .admin-app {
                display: block;
            }

            .admin-sidebar {
                position: fixed;
                inset: 12px auto 12px 12px;
                z-index: 1000;
                width: min(288px, calc(100vw - 24px));
                height: auto;
                border-radius: 20px;
                transform: translateX(calc(-100% - 24px));
                transition: transform .25s ease;
            }

            body.admin-sidebar-collapsed .admin-app {
                grid-template-columns: 1fr;
            }

            body.admin-menu-open .admin-sidebar {
                transform: translateX(0);
            }

            .admin-mobile-overlay {
                position: fixed;
                inset: 0;
                z-index: 990;
                background: rgba(0, 0, 0, .35);
            }

            body.admin-menu-open .admin-mobile-overlay {
                display: block;
            }

            .admin-content {
                padding: 16px;
            }

            .admin-menu-toggle-sidebar {
                display: none;
            }

            .admin-menu-toggle-mobile {
                display: inline-flex;
            }

            body.admin-sidebar-collapsed .admin-brand-copy,
            body.admin-sidebar-collapsed .admin-nav-title,
            body.admin-sidebar-collapsed .admin-nav-link span,
            body.admin-sidebar-collapsed .admin-sidebar-logout span,
            body.admin-sidebar-collapsed .admin-sidebar-user {
                display: block;
            }

            body.admin-sidebar-collapsed .admin-brand,
            body.admin-sidebar-collapsed .admin-nav-link {
                justify-content: flex-start;
                padding-inline: 12px;
                grid-template-columns: 20px minmax(0, 1fr);
                justify-items: stretch;
            }

            body.admin-sidebar-collapsed .admin-brand-main {
                width: auto;
            }

            body.admin-sidebar-collapsed .admin-brand {
                justify-content: center;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_PlatformMessages" />

    <div class="admin-mobile-overlay" data-admin-close></div>
    <div class="admin-app">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <div class="admin-brand-main">
                    <img src="/img/logo.png" alt="Anderson Multimarcas">
                    <div class="admin-brand-copy">
                        <strong>Multimarcas</strong>
                        <span>Painel administrativo</span>
                    </div>
                </div>
                <button type="button" class="admin-menu-toggle admin-menu-toggle-sidebar" data-admin-toggle aria-label="Alternar menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <nav class="admin-nav">
                @foreach (var section in AdminMenuCatalog.Sections)
                {
                    var items = section.Items.Where(CanShowMenu).ToList();
                    if (items.Count == 0)
                    {
                        continue;
                    }

                    <div class="admin-nav-title">@(section.Title)</div>
                    @foreach (var item in items)
                    {
                        <a class="admin-nav-link @(IsMenuActive(item) ? "active" : "")" href="@item.Url">
                            <i class="@item.Icon"></i>
                            <span>@item.Label</span>
                        </a>
                    }
                }
            </nav>

            <div class="admin-sidebar-footer">
                <div class="admin-sidebar-user">
                    <strong>@User.Identity?.Name</strong>
                    <span>Multimarcas</span>
                </div>

                <form method="post" action="/Login?handler=Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-sidebar-logout" aria-label="Sair">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sair</span>
                    </button>
                </form>
            </div>
        </aside>

        <section class="admin-main">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="admin-menu-toggle admin-menu-toggle-mobile" data-admin-toggle aria-label="Abrir menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="admin-title">
                        <strong>@title</strong>
                        <span>Anderson Multimarcas</span>
                    </div>
                </div>

                <div class="admin-user-pill">@User.Identity?.Name</div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                © 2026 - ERP Anderson Multimarcas
            </footer>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const storageKey = 'admin-sidebar-collapsed';
            const mobileQuery = window.matchMedia('(max-width: 980px)');
            const body = document.body;

            function applyDesktopState() {
                if (mobileQuery.matches) {
                    body.classList.remove('admin-sidebar-collapsed');
                    return;
                }

                const collapsed = localStorage.getItem(storageKey);
                if (collapsed === null || collapsed === 'true') {
                    body.classList.add('admin-sidebar-collapsed');
                } else {
                    body.classList.remove('admin-sidebar-collapsed');
                }
            }

            document.querySelectorAll('[data-admin-toggle]').forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    if (mobileQuery.matches) {
                        body.classList.toggle('admin-menu-open');
                        syncToggleState();
                        return;
                    }

                    const collapsed = !body.classList.contains('admin-sidebar-collapsed');
                    body.classList.toggle('admin-sidebar-collapsed', collapsed);
                    localStorage.setItem(storageKey, collapsed ? 'true' : 'false');
                    syncToggleState();
                });
            });

            function closeMobileMenu() {
                body.classList.remove('admin-menu-open');
                syncToggleState();
            }

            function syncToggleState() {
                const expanded = mobileQuery.matches
                    ? body.classList.contains('admin-menu-open')
                    : !body.classList.contains('admin-sidebar-collapsed');

                document.querySelectorAll('[data-admin-toggle]').forEach(function (toggle) {
                    toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                });
            }

            document.querySelector('[data-admin-close]')?.addEventListener('click', closeMobileMenu);

            document.querySelectorAll('.admin-nav-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (mobileQuery.matches) {
                        closeMobileMenu();
                    }
                });
            });

            mobileQuery.addEventListener('change', function () {
                body.classList.remove('admin-menu-open');
                applyDesktopState();
                syncToggleState();
            });

            applyDesktopState();
            syncToggleState();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
