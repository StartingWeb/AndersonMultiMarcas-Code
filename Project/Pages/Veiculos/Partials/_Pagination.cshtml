@model (int CurrentPage, int TotalPages)
@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginacao" class="catalog-pagination-wrap">
        <p class="catalog-pagination-status">Pagina @Model.CurrentPage de @Model.TotalPages</p>
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                var query = new Dictionary<string, string?>();
                foreach (var item in ViewContext.HttpContext.Request.Query)
                {
                    if (!string.Equals(item.Key, "page", StringComparison.OrdinalIgnoreCase))
                    {
                        query[item.Key] = item.Value;
                    }
                }
                query["page"] = i.ToString();
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@(ViewContext.HttpContext.Request.Path + QueryString.Create(query).ToString())" aria-current="@(i == Model.CurrentPage ? "page" : null)">@i</a>
                </li>
            }
        </ul>
    </nav>
}
