@page
@model Project.Pages.ContatoModel
@{
    ViewData["Title"] = "Contato";
    ViewData["ShowHero"] = false;
}

<link rel="stylesheet" href="~/css/Contato.css" />

<section class="section contact-page-section">
    <div class="container">
        <div class="contact-section-header">
            <h2 class="section-title">Nossas lojas</h2>
            <p class="section-subtitle mb-0">
                Endereço, telefone, e-mail, mapa e vendedores de cada unidade em um só lugar.
            </p>
        </div>

        @if (Model.Stores.Any())
        {
            <div class="contact-store-accordion">
                @foreach (var store in Model.Stores)
                {
                    <details class="contact-store-card">
                        <summary class="contact-store-summary">
                            <div class="contact-store-summary-main">
                                <span class="contact-store-tag">Unidade</span>
                                <h3>@store.Name</h3>
                                <p>@store.Address</p>
                            </div>

                            <div class="contact-store-summary-side">
                                <div class="contact-store-summary-metric">
                                    <strong>@store.Sellers.Count</strong>
                                    <span>vendedores</span>
                                </div>
                                <span class="contact-store-summary-icon" aria-hidden="true"></span>
                            </div>
                        </summary>

                        <div class="contact-store-content">
                            <div class="contact-store-grid">
                                <div class="contact-info-card">
                                    <span class="contact-info-label">Endereço</span>
                                    <strong>@store.Address</strong>
                                </div>

                                <div class="contact-info-card">
                                    <span class="contact-info-label">Telefone</span>
                                    @if (!string.IsNullOrWhiteSpace(store.PhoneDisplay))
                                    {
                                        <a href="@store.PhoneUrl">@store.PhoneDisplay</a>
                                    }
                                    else
                                    {
                                        <strong>Não informado</strong>
                                    }
                                </div>

                                <div class="contact-info-card">
                                    <span class="contact-info-label">E-mail</span>
                                    @if (!string.IsNullOrWhiteSpace(store.Email))
                                    {
                                        <a href="mailto:@store.Email">@store.Email</a>
                                    }
                                    else
                                    {
                                        <strong>Não informado</strong>
                                    }
                                </div>

                                <div class="contact-info-card contact-info-card-action">
                                    <span class="contact-info-label">Rota rápida</span>
                                    <a href="@store.MapsLinkUrl" target="_blank" class="btn btn-outline-brand contact-map-button">Abrir rota</a>
                                </div>
                            </div>

                            <div class="contact-store-expand-grid">
                                <div class="contact-store-map">
                                    <iframe
                                        src="@store.MapsEmbedUrl"
                                        title="Mapa da loja @store.Name"
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                                </div>

                                <div class="contact-store-sellers-panel">
                                    <div class="contact-store-sellers-header">
                                        <h4>Vendedores da loja</h4>
                                        <span>@store.Sellers.Count</span>
                                    </div>

                                    @if (store.Sellers.Any())
                                    {
                                        <div class="contact-seller-list">
                                            @foreach (var seller in store.Sellers)
                                            {
                                                <article class="contact-seller-list-item">
                                                    <div class="contact-seller-list-media">
                                                        @if (!string.IsNullOrWhiteSpace(seller.PhotoUrl))
                                                        {
                                                            <img src="@seller.PhotoUrl" alt="@seller.Name" class="contact-seller-list-photo" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <div class="contact-seller-list-photo contact-seller-photo-fallback" aria-hidden="true">
                                                                <i class="bi bi-person-badge-fill"></i>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="contact-seller-list-body">
                                                        <span class="contact-seller-store">@seller.StoreName</span>
                                                        <h3>@seller.Name</h3>
                                                        <p class="contact-seller-role">@seller.Role</p>
                                                    </div>

                                                    <div class="contact-seller-list-actions">
                                                        @if (!string.IsNullOrWhiteSpace(seller.PhoneDisplay))
                                                        {
                                                            <a href="@seller.PhoneUrl" class="contact-action-link">
                                                                <span class="contact-action-icon" aria-hidden="true">
                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.61a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6.27 6.27l1.29-1.29a2 2 0 0 1 2.11-.45c.83.3 1.71.51 2.61.63A2 2 0 0 1 22 16.92z"></path>
                                                                    </svg>
                                                                </span>
                                                                <span>Ligar</span>
                                                            </a>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(seller.WhatsappDisplay))
                                                        {
                                                            <a href="@seller.WhatsappUrl" target="_blank" class="contact-action-link is-whatsapp">
                                                                <span class="contact-action-icon" aria-hidden="true">
                                                                    <svg viewBox="0 0 32 32" fill="currentColor">
                                                                        <path d="M19.11 17.34c-.27-.14-1.57-.77-1.81-.86-.24-.09-.41-.14-.59.14-.18.27-.68.86-.84 1.04-.15.18-.31.2-.58.07-.27-.14-1.12-.41-2.14-1.32-.79-.7-1.33-1.56-1.49-1.83-.15-.27-.02-.41.12-.54.12-.12.27-.31.41-.46.14-.15.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.59-1.42-.8-1.95-.21-.5-.43-.43-.59-.44h-.5c-.18 0-.48.07-.73.34-.25.27-.96.93-.96 2.28 0 1.35.98 2.66 1.12 2.84.14.18 1.93 2.95 4.67 4.13.65.28 1.16.44 1.56.56.66.21 1.26.18 1.74.11.53-.08 1.57-.64 1.79-1.27.22-.63.22-1.17.15-1.28-.07-.11-.25-.18-.52-.32z"></path>
                                                                        <path d="M16.01 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.25.58 4.45 1.69 6.39L3.2 28.8l6.57-1.67c1.87 1.02 3.97 1.56 6.24 1.56h.01c7.07 0 12.8-5.73 12.8-12.8S23.09 3.2 16.01 3.2zm0 23.35h-.01c-1.92 0-3.8-.52-5.45-1.5l-.39-.23-3.9.99 1.04-3.8-.25-.39a10.6 10.6 0 0 1-1.63-5.71c0-5.88 4.78-10.66 10.66-10.66 2.85 0 5.53 1.11 7.54 3.12a10.59 10.59 0 0 1 3.12 7.53c0 5.88-4.78 10.65-10.65 10.65z"></path>
                                                                    </svg>
                                                                </span>
                                                                <span>WhatsApp</span>
                                                            </a>
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="contact-empty-inline">
                                            Nenhum vendedor vinculado a esta loja no momento.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="feature-card">
                <h5 class="fw-bold mb-2">Nenhuma loja ativa encontrada</h5>
                <p class="text-muted mb-0">Cadastre lojas ativas no painel para exibi-las nesta página.</p>
            </div>
        }
    </div>
</section>
